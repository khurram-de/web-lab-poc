/* ========================================================================== */
/* MultiLoad Script - Bulk Load Sales Data                                   */
/* Demonstrates MLOAD for bulk data loading                                  */
/* Run: mload < 07-mload-sales.mload                                         */
/* ========================================================================== */

/* Connect using environment variables */
.LOGTABLE ${DB_USERNAME}_DEMO.SALES_MLOAD_LOG;
.LOGON ${DB_HOST}/${DB_USERNAME},${DB_PASSWORD};

/* Begin MultiLoad */
.BEGIN MLOAD
    TABLES SALES
    WORKTABLES SALES_WT
    ERRORTABLES SALES_ET SALES_UV;

/* Set database */
DATABASE ${DB_USERNAME}_DEMO;

/* ========================================================================== */
/* Phase 1: Delete existing data (optional - comment out if keeping data)    */
/* ========================================================================== */

/* Uncomment to clear existing sales data before load */
/* .DELETE FROM SALES WHERE SALE_ID >= 100; */

/* ========================================================================== */
/* Phase 2: Insert new data                                                  */
/* ========================================================================== */

.DML LABEL INSERTSALES;

INSERT INTO SALES (
    SALE_ID,
    SALE_DATE,
    PRODUCT_ID,
    QUANTITY,
    SALE_AMOUNT,
    CUSTOMER_ID,
    REGION
)
VALUES (
    :SALE_ID,
    :SALE_DATE,
    :PRODUCT_ID,
    :QUANTITY,
    :SALE_AMOUNT,
    :CUSTOMER_ID,
    :REGION
);

/* ========================================================================== */
/* Define input layout                                                        */
/* ========================================================================== */

.LAYOUT SALESLAYOUT;
.FIELD SALE_ID       * INTEGER;
.FIELD SALE_DATE     * VARCHAR(10);  /* Format: YYYY-MM-DD */
.FIELD PRODUCT_ID    * INTEGER;
.FIELD QUANTITY      * INTEGER;
.FIELD SALE_AMOUNT   * DECIMAL(10,2);
.FIELD CUSTOMER_ID   * INTEGER;
.FIELD REGION        * VARCHAR(20);

/* ========================================================================== */
/* Import data file                                                           */
/* ========================================================================== */

.IMPORT INFILE /workspace/sales_data.txt
    LAYOUT SALESLAYOUT
    APPLY INSERTSALES;

/* ========================================================================== */
/* End MultiLoad and cleanup                                                 */
/* ========================================================================== */

.END MLOAD;

.LOGOFF;
.QUIT;
